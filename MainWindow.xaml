<Window x:Class="PrismStrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="PrismStrap" Height="760" Width="1080"
        MinHeight="660" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico"
        Foreground="#F4F4F5"
        Background="#111215">

    <Window.Resources>
        <!-- Modern Sidebar Nav Button Style -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1C1E24" />
                                <Setter Property="Foreground" Value="#E4E4E7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2128" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderBrush" Value="#2E313D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#292C36" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3F4352" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A1C22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group Card Style -->
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#16171D" />
            <Setter Property="BorderBrush" Value="#23252E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Radio Option Card Style -->
        <Style x:Key="SoundOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <!-- Main Body -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#131418" BorderBrush="#20222A" BorderThickness="0,0,1,0" Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Row="0" Margin="6,0,6,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PrismStrap" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Border Background="#21242D" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.3.0" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtAppSubtitle" Text="Roblox Bootstrapper" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavHome" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="🏠  概要" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPerf" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="⚡  パフォーマンス" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavGfx" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="🎨  グラフィック" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSounds" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="🔊  サウンド" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFlags" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="🛠️  FastFlags" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMods" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="🎭  外観・MOD" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSys" GroupName="NavMainGroup" Style="{StaticResource NavRadioButtonStyle}" Content="⚙️  システム統合" Checked="Nav_Checked" />
                </StackPanel>

                <!-- Sidebar Footer (Status & Updates) -->
                <StackPanel Grid.Row="2" Margin="4,0,4,4">
                    <Border Background="#1A1C22" BorderBrush="#262933" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtStatusBadge" Text="Roblox: 準備完了" FontSize="11" Foreground="#9CA3AF" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnCheckUpdates" Content="更新を確認" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" Click="BtnCheckUpdates_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Margin="32,20,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- COMMON TOP HEADER BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="概要" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Robloxの動作環境とシステムステータス" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Top Right Controls: Language Selector + Launch Button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Language Selector ComboBox -->
                    <ComboBox x:Name="ComboLanguage" Width="145" Height="34" Margin="0,0,12,0" 
                              Background="#1B1D24" Foreground="#FFFFFF" BorderBrush="#2D303B" 
                              VerticalContentAlignment="Center" Padding="8,4" FontSize="12"
                              SelectionChanged="ComboLanguage_SelectionChanged">
                        <ComboBoxItem Content="🇯🇵 日本語" Tag="ja" />
                        <ComboBoxItem Content="🇺🇸 English" Tag="en" />
                        <ComboBoxItem Content="🇰🇷 한국어" Tag="ko" />
                        <ComboBoxItem Content="🇮🇩 Indonesia" Tag="id" />
                        <ComboBoxItem Content="🇨🇳 简体中文" Tag="zh" />
                        <ComboBoxItem Content="🇧🇷 Português" Tag="pt" />
                    </ComboBox>

                    <Button x:Name="BtnTopLaunch" Content="Robloxを起動" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="18,8" FontSize="13" Click="BtnLaunchRoblox_Click" />
                </StackPanel>
            </Grid>

            <!-- PAGES CONTAINER -->
            <Grid Grid.Row="1">

                <!-- 1. 概要 (Home/Dashboard) -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Hero Launch Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#142B20" BorderBrush="#1F4E37" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="TxtBadgeReady" Text="最新バージョン利用可能" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                        </Border>
                                        <TextBlock x:Name="TxtVersionHash" Text="検出中..." FontSize="11" Foreground="#71717A" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHeroTitle" Text="最適化設定を適用して起動" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="TxtHeroDesc" Text="FPS上限解除や指定したグラフィックス設定・死亡サウンドを反映した状態でRobloxを立ち上げます。" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500" />
                                </StackPanel>
                                <Button x:Name="BtnHeroLaunch" Grid.Column="1" Content="▶  今すぐプレイ" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Padding="24,12" VerticalAlignment="Center" Click="BtnLaunchRoblox_Click" />
                            </Grid>
                        </Border>

                        <!-- 4 Metric Cards -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource GroupCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="LblStatFps" Text="FPS上限" FontSize="11" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtStatFps" Text="UNLIMITED" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource GroupCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="LblStatGfx" Text="グラフィックAPI" FontSize="11" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtStatApi" Text="Vulkan" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource GroupCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="LblStatSound" Text="死亡サウンド" FontSize="11" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtStatSound" Text="Classic OOF" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Style="{StaticResource GroupCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock x:Name="LblStatProto" Text="ブラウザ連携" FontSize="11" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtStatProtocol" Text="有効" FontSize="18" FontWeight="Bold" Foreground="#A855F7" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- System Directory Details -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="LblSysInfo" Text="システム情報" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="LblRobloxDir" Text="Robloxフォルダ" FontSize="12" Foreground="#9CA3AF" Width="140" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TxtRobloxDir" Text="検出中..." FontSize="12" Foreground="#E4E4E7" Margin="140,0,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="LblPlayerExe" Text="実行ファイル" FontSize="12" Foreground="#9CA3AF" Width="140" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TxtPlayerExe" Text="検出中..." FontSize="12" Foreground="#E4E4E7" Margin="140,0,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. パフォーマンス (Performance) -->
                <ScrollViewer x:Name="PagePerf" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- FPS Unlocker Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="LblFpsCardTitle" Text="フレームレート上限解除 (FPS Unlocker)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock x:Name="LblFpsCardDesc" Text="Robloxの標準60FPS制限を解除します。0に設定すると上限なし（無制限）になります。" FontSize="12" Foreground="#71717A" Margin="0,4,0,16" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,16">
                                    <TextBlock x:Name="LblTargetFps" Text="目標フレームレート (FPS)" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtTargetFps" Text="0" Width="100" HorizontalAlignment="Right" Background="#1B1D24" Foreground="#FFFFFF" BorderBrush="#2D303B" Padding="10,6" FontSize="13" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" />
                                </Grid>

                                <!-- Preset Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="LblPresets" Text="プリセット:" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="60" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Tag="60" Click="BtnPresetFps_Click" />
                                    <Button Content="144" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Tag="144" Click="BtnPresetFps_Click" />
                                    <Button Content="240" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Tag="240" Click="BtnPresetFps_Click" />
                                    <Button Content="360" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Tag="360" Click="BtnPresetFps_Click" />
                                    <Button x:Name="BtnPresetUnlimited" Content="無制限 (0)" Style="{StaticResource PillButtonStyle}" Tag="0" Click="BtnPresetFps_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnSavePerf" Content="設定を保存して適用" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="20,10" HorizontalAlignment="Left" Click="BtnSaveSettings_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. グラフィック (Graphics) -->
                <ScrollViewer x:Name="PageGfx" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Rendering API Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="LblApiCardTitle" Text="レンダリングAPI" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock x:Name="LblApiCardDesc" Text="Robloxの画面描画に使用するグラフィックエンジンを選択します" FontSize="12" Foreground="#71717A" Margin="0,4,0,16" />

                                <StackPanel>
                                    <RadioButton x:Name="RadioApiDefault" GroupName="GraphicsApiGroup" Content="自動 (Direct3D 11/自動検出)" Style="{StaticResource SoundOptionStyle}" IsChecked="True" />
                                    <RadioButton x:Name="RadioApiVulkan" GroupName="GraphicsApiGroup" Content="Vulkan (低遅延・高フレームレート)" Style="{StaticResource SoundOptionStyle}" />
                                    <RadioButton x:Name="RadioApiD3d11" GroupName="GraphicsApiGroup" Content="Direct3D 11 (安定性重視)" Style="{StaticResource SoundOptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Texture Quality Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                                    <TextBlock x:Name="LblMaxTexture" Text="テクスチャ品質の最大化" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="LblMaxTextureDesc" Text="解像度に関係なく常に最大解像度のテクスチャをロードします。" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="SwitchTexture" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" />
                            </Grid>
                        </Border>

                        <!-- Post FX Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                                    <TextBlock x:Name="LblDisablePostFx" Text="ポストエフェクトの無効化 (軽量化)" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="LblDisablePostFxDesc" Text="ブルームや被写界深度等の後処理を無効にし、FPSと応答速度を向上させます。" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="SwitchPostFx" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Classic Esc Menu Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                                    <TextBlock x:Name="LblClassicMenu" Text="クラシック Esc メニュー (2020スタイル)" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="LblClassicMenuDesc" Text="新しい全画面メニューではなく、以前の使い慣れた軽量Escメニューを表示します。" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="SwitchClassicMenu" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Button x:Name="BtnSaveGfx" Content="設定を保存して適用" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="20,10" HorizontalAlignment="Left" Click="BtnSaveSettings_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. サウンド (Sounds / OOF) - NEW! -->
                <ScrollViewer x:Name="PageSounds" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Death Sound Effect Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="LblDeathSoundTitle" Text="死亡時サウンド (OOF音)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock x:Name="LblDeathSoundDesc" Text="キャラクターがリセットまたは倒れた時に再生される効果音（ouch.ogg）を変更します。" FontSize="12" Foreground="#71717A" Margin="0,4,0,16" TextWrapping="Wrap" />

                                <!-- Sound Preset Radio Buttons -->
                                <StackPanel Margin="0,0,0,14">
                                    <RadioButton x:Name="RadioSoundClassicOof" GroupName="DeathSoundGroup" Content="元祖 Roblox OOF サウンド (2006-2022)" Style="{StaticResource SoundOptionStyle}" IsChecked="True" Checked="SoundRadio_Checked" />
                                    <RadioButton x:Name="RadioSoundVineBoom" GroupName="DeathSoundGroup" Content="Vine Boom (人気ミーム音)" Style="{StaticResource SoundOptionStyle}" Checked="SoundRadio_Checked" />
                                    <RadioButton x:Name="RadioSoundCustom" GroupName="DeathSoundGroup" Content="カスタム MP3 音源" Style="{StaticResource SoundOptionStyle}" Checked="SoundRadio_Checked" />
                                    <RadioButton x:Name="RadioSoundDefault" GroupName="DeathSoundGroup" Content="Roblox 標準サウンド (公式デフォルト)" Style="{StaticResource SoundOptionStyle}" Checked="SoundRadio_Checked" />
                                </StackPanel>

                                <!-- Custom MP3 File Selection Panel -->
                                <Border x:Name="PanelCustomSound" Background="#1A1C24" BorderBrush="#262933" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCustomSoundInstruction" Text="お好みの MP3 ファイルを選択してください:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCustomSoundPath" Grid.Column="0" IsReadOnly="True" Background="#131418" Foreground="#E4E4E7" BorderBrush="#2D303B" Padding="10,6" FontSize="12" FontFamily="Consolas" Text="未選択" />
                                            <Button x:Name="BtnBrowseCustomSound" Grid.Column="2" Content="MP3ファイルを選択..." Style="{StaticResource PillButtonStyle}" Click="BtnBrowseCustomSound_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Audio Effects (Volume & Speed) Card -->
                                <Border Background="#1A1C24" BorderBrush="#262933" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LblAudioEffectsTitle" Text="音響エフェクト調整" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                <TextBlock x:Name="LblAudioEffectsDesc" Text="死亡時サウンドの音量と再生速度（ピッチ）をカスタマイズします" FontSize="11" Foreground="#71717A" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="BtnResetAudio" Content="初期値にリセット" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" FontSize="11" Click="BtnResetAudio_Click" />
                                        </Grid>

                                        <!-- Volume Slider -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblVolume" Text="音量 (Volume)" FontSize="12" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                            <Slider x:Name="SliderVolume" Grid.Column="1" Minimum="0" Maximum="300" Value="100" VerticalAlignment="Center" Margin="10,0" ValueChanged="SliderAudio_ValueChanged" />
                                            <TextBlock x:Name="TxtVolumeVal" Grid.Column="2" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>

                                        <!-- Speed Slider -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblSpeed" Text="再生速度 (Speed / ピッチ連動)" FontSize="12" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                            <Slider x:Name="SliderSpeed" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="1.0" SmallChange="0.05" VerticalAlignment="Center" Margin="10,0" ValueChanged="SliderAudio_ValueChanged" />
                                            <TextBlock x:Name="TxtSpeedVal" Grid.Column="2" Text="1.0x" FontSize="12" FontWeight="Bold" Foreground="#10B981" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons: Preview & Apply -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="BtnPreviewSound" Content="▶  試聴する" Style="{StaticResource PillButtonStyle}" Margin="0,0,10,0" Padding="16,8" Click="BtnPreviewSound_Click" />
                                    <Button x:Name="BtnApplySound" Content="死亡サウンドを適用" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="18,8" Click="BtnApplySound_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. FastFlags エディタ -->
                <ScrollViewer x:Name="PageFlags" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Add Flag Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="LblAddFlagTitle" Text="カスタム FastFlag の追加" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewFlagKey" Grid.Column="0" Text="" Background="#1B1D24" Foreground="#E4E4E7" BorderBrush="#2D303B" Padding="10,6" FontSize="12" FontFamily="Consolas" />
                                    <TextBox x:Name="TxtNewFlagVal" Grid.Column="2" Text="" Background="#1B1D24" Foreground="#E4E4E7" BorderBrush="#2D303B" Padding="10,6" FontSize="12" FontFamily="Consolas" />
                                    <Button x:Name="BtnAddFlag" Grid.Column="4" Content="追加" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" Click="BtnAddFlag_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Flags List Card -->
                        <Border Style="{StaticResource GroupCardStyle}" Padding="0">
                            <StackPanel>
                                <Border Background="#1A1C22" Padding="16,10" BorderBrush="#262933" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock x:Name="LblRegisteredFlags" Text="登録済みフラグ一覧" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtFlagCount" Text="0 flags" FontSize="11" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="ListFlags" Background="Transparent" BorderThickness="0" MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Foreground="#60A5FA" FontFamily="Consolas" FontSize="12" />
                                                    <TextBlock Text=" = " Foreground="#71717A" FontFamily="Consolas" FontSize="12" />
                                                    <TextBlock Text="{Binding Value}" Foreground="#E4E4E7" FontFamily="Consolas" FontSize="12" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="削除" Style="{StaticResource PillButtonStyle}" Padding="8,3" FontSize="10" Foreground="#F87171" Click="BtnDeleteFlag_Click" Tag="{Binding Key}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. システム統合 (Integration) -->
                <ScrollViewer x:Name="PageSys" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Language Card in System Page -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                                    <TextBlock x:Name="LblSysLangTitle" Text="表示言語 (Language)" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="LblSysLangDesc" Text="PrismStrapのUI表示言語を切り替えます。" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ComboSysLanguage" Width="170" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Background="#1B1D24" Foreground="#FFFFFF" BorderBrush="#2D303B" 
                                          VerticalContentAlignment="Center" Padding="8,4" FontSize="12"
                                          SelectionChanged="ComboSysLanguage_SelectionChanged">
                                    <ComboBoxItem Content="🇯🇵 日本語" Tag="ja" />
                                    <ComboBoxItem Content="🇺🇸 English" Tag="en" />
                                    <ComboBoxItem Content="🇰🇷 한국어" Tag="ko" />
                                    <ComboBoxItem Content="🇮🇩 Indonesia" Tag="id" />
                                    <ComboBoxItem Content="🇨🇳 简体中文" Tag="zh" />
                                    <ComboBoxItem Content="🇧🇷 Português" Tag="pt" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Protocol Handler Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                                    <TextBlock x:Name="LblProtocolTitle" Text="roblox-player:// プロトコルハンドラー" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="LblProtocolDesc" Text="ブラウザ上でRobloxの「プレイ」ボタンをクリックした際に、公式ブートストラップではなくPrismStrapを立ち上げます。" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="BtnProtocolToggle" Grid.Column="1" Content="登録する" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnProtocolToggle_Click" />
                            </Grid>
                        </Border>

                        <!-- Shortcuts Card -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LblShortcutTitle" Text="ショートカットの再生成" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="LblShortcutDesc" Text="デスクトップおよびスタートメニューのショートカットを再作成します。" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button x:Name="BtnRecreateShortcuts" Content="ショートカット作成" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRecreateShortcuts_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7. APPEARANCE & MODS PANEL -->
                <ScrollViewer x:Name="PageMods" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,24">

                        <!-- CARD 1: CUSTOM FONT -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtFontTitle" Text="ゲーム内カスタムフォント" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="TxtFontDesc" Text="RobloxのUIやチャットのフォントをお好みの書体に変更します" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="ComboCustomFont" Height="36" Background="#1B1D24" Foreground="#FFFFFF" BorderBrush="#2D303B" VerticalContentAlignment="Center" Padding="10,4" FontSize="12" SelectionChanged="ComboCustomFont_SelectionChanged">
                                        <ComboBoxItem Content="公式デフォルト (Builder Sans)" Tag="Default" />
                                        <ComboBoxItem Content="Comic Sans MS (手書き風・高視認性)" Tag="ComicSans" />
                                        <ComboBoxItem Content="Segoe UI (Windows 11 Fluent)" Tag="SegoeUI" />
                                        <ComboBoxItem Content="Arial (シンプル・クリーン)" Tag="Arial" />
                                        <ComboBoxItem Content="カスタムフォント (.ttf / .otf)..." Tag="Custom" />
                                    </ComboBox>

                                    <Button x:Name="BtnBrowseFont" Grid.Column="1" Content="ファイル選択..." Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" Click="BtnBrowseFont_Click" Visibility="Collapsed" />
                                </Grid>

                                <!-- Font Live Preview Box -->
                                <Border Background="#101115" BorderBrush="#21232B" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="フォントプレビュー" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6" />
                                        <TextBlock x:Name="TxtFontPreview" Text="Roblox を、もっと自由に。美しく、軽快に。&#x0a;The quick brown fox jumps over the lazy dog 1234567890" FontSize="14" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: MOUSE CURSOR -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCursorTitle" Text="マウスポインター (カーソル)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="TxtCursorDesc" Text="Robloxゲーム内のマウスポインターをお好みのデザインに変更します" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="ComboCursor" Height="36" Background="#1B1D24" Foreground="#FFFFFF" BorderBrush="#2D303B" VerticalContentAlignment="Center" Padding="10,4" FontSize="12" SelectionChanged="ComboCursor_SelectionChanged">
                                        <ComboBoxItem Content="公式デフォルト (2020+)" Tag="Default" />
                                        <ComboBoxItem Content="クラシック 2013-2020 (太枠白矢印)" Tag="Classic2013" />
                                        <ComboBoxItem Content="クラシック 2006-2013 (レトロピクセル)" Tag="Classic2006" />
                                        <ComboBoxItem Content="クリーン Modern (Windows 11風)" Tag="CleanModern" />
                                        <ComboBoxItem Content="カスタム画像 (.png)..." Tag="Custom" />
                                    </ComboBox>

                                    <Button x:Name="BtnBrowseCursor" Grid.Column="1" Content="画像選択..." Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" Click="BtnBrowseCursor_Click" Visibility="Collapsed" />
                                </Grid>

                                <!-- Cursor Live Preview Box -->
                                <Border Background="#101115" BorderBrush="#21232B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" Background="#1A1C24" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="6" Margin="0,0,14,0">
                                                <Image x:Name="ImgCursorPreview" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCursorPreviewName" Text="公式デフォルト (2020+)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                <TextBlock Text="ゲーム内で操作時に表示されるマウスポインター" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: ROBLOX APP ICON -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtIconTitle" Text="Roblox アプリアイコン" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="TxtIconDesc" Text="デスクトップやスタートメニュー、タスクバーのRobloxアイコンを着せ替えます" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Icon Selection Grid -->
                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                    <!-- Modern 2022 -->
                                    <RadioButton x:Name="RadioIcon2022" GroupName="AppIconGroup" Tag="Modern2022" Checked="RadioIcon_Checked" Style="{StaticResource SoundOptionStyle}" Margin="3">
                                        <Border Background="#1A1C24" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="8" Padding="8,10" HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image x:Name="ImgIcon2022" Width="40" Height="40" Margin="0,0,0,6" />
                                                <TextBlock Text="Modern 2022" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="最新シルバー" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>

                                    <!-- Tilted Red 2017 -->
                                    <RadioButton x:Name="RadioIcon2017" GroupName="AppIconGroup" Tag="Tilted2017" Checked="RadioIcon_Checked" Style="{StaticResource SoundOptionStyle}" Margin="3">
                                        <Border Background="#1A1C24" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="8" Padding="8,10" HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image x:Name="ImgIcon2017" Width="40" Height="40" Margin="0,0,0,6" />
                                                <TextBlock Text="Classic 2017" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="チルトレッド" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>

                                    <!-- Red Square 2015 -->
                                    <RadioButton x:Name="RadioIcon2015" GroupName="AppIconGroup" Tag="RedSquare2015" Checked="RadioIcon_Checked" Style="{StaticResource SoundOptionStyle}" Margin="3">
                                        <Border Background="#1A1C24" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="8" Padding="8,10" HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image x:Name="ImgIcon2015" Width="40" Height="40" Margin="0,0,0,6" />
                                                <TextBlock Text="Classic 2015" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="赤ブロック" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>

                                    <!-- Classic 2008 'R' -->
                                    <RadioButton x:Name="RadioIcon2008" GroupName="AppIconGroup" Tag="Classic2008" Checked="RadioIcon_Checked" Style="{StaticResource SoundOptionStyle}" Margin="3">
                                        <Border Background="#1A1C24" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="8" Padding="8,10" HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image x:Name="ImgIcon2008" Width="40" Height="40" Margin="0,0,0,6" />
                                                <TextBlock Text="Classic 2008" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="伝説の赤R" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>

                                    <!-- Prism Neon -->
                                    <RadioButton x:Name="RadioIconPrism" GroupName="AppIconGroup" Tag="PrismNeon" Checked="RadioIcon_Checked" Style="{StaticResource SoundOptionStyle}" Margin="3">
                                        <Border Background="#1A1C24" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="8" Padding="8,10" HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Image x:Name="ImgIconPrism" Width="40" Height="40" Margin="0,0,0,6" />
                                                <TextBlock Text="Prism Neon" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock Text="プリズム特製" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>
                                </UniformGrid>

                                <Button x:Name="BtnApplyIconNow" Content="アイコンを今すぐ適用" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Click="BtnApplyIconNow_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Save Button for Mods -->
                        <Button x:Name="BtnSaveMods" Content="外観設定を保存して適用" Style="{StaticResource PillButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="SemiBold" Height="40" Margin="0,4,0,0" Click="BtnSaveMods_Click" />

                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Subtle Toast Notification (Bottom Right) -->
            <Border x:Name="ToastNotification" Grid.Row="1" Background="#1E2028" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓  " Foreground="#34D399" FontWeight="Bold" />
                    <TextBlock x:Name="TxtToast" Text="設定を保存しました" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
