<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <NoWarn>NU1701</NoWarn>
    <AssemblyName>PrismStrap</AssemblyName>
    <RootNamespace>PrismStrap</RootNamespace>
    <Version>0.3.0</Version>
    <Company>PrismStrap Team</Company>
    <Product>PrismStrap</Product>
    <Description>Next-Gen Roblox Bootstrapper</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <EmbeddedResource Include="Sounds\classic_oof.mp3" />
    <EmbeddedResource Include="Sounds\classic_oof.ogg" />
    <EmbeddedResource Include="Sounds\vine_boom.mp3" />
    <EmbeddedResource Include="Sounds\vine_boom.ogg" />
    <EmbeddedResource Include="Assets\Appearance\**" />
    <Content Include="Assets\Appearance\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
    <Page Remove="Installer\**" />
    <Compile Remove="website\**" />
    <EmbeddedResource Remove="website\**" />
    <None Remove="website\**" />
    <Page Remove="website\**" />
  </ItemGroup>

</Project>
