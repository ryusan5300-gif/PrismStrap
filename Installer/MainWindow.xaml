<Window x:Class="PrismStrap.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrismStrap Setup" Height="410" Width="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        Icon="icon.ico"
        ShowInTaskbar="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Pill Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2128" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderBrush" Value="#2E313D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#292C36" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3F4352" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A1C22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <!-- Dark ComboBox ToggleButton -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border" CornerRadius="8" Background="#1E2028" BorderBrush="#2E313D" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" Fill="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#262933" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3F4352" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="6" Background="Transparent" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2D3A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,3,28,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#181A22" 
                                            BorderThickness="1" 
                                            BorderBrush="#2E313D" 
                                            CornerRadius="8" 
                                            Margin="0,4,0,4" 
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Padding="22,18" Background="#16171D" BorderBrush="#2D303B" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header (Icon + Title + Language Selector + Close) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="icon.ico" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtTitle" Text="PrismStrap セットアップ" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Background="#21242D" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v0.3.0" FontSize="9" FontWeight="SemiBold" Foreground="#9CA3AF" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Language Picker -->
                    <ComboBox x:Name="ComboLang" Width="135" Height="28" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,10,0" SelectionChanged="ComboLang_SelectionChanged" />

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#71717A" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#292C36" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- STEP 1: Configuration Panel -->
            <Grid Grid.Row="1" x:Name="PanelConfig" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtWelcomeHeader" Text="PrismStrap のインストール" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Grid.Row="0" x:Name="TxtWelcomeDesc" Text="Roblox体験を最適化する次世代ブートストラッパーをPCにセットアップします。" FontSize="11" Foreground="#9CA3AF" Margin="0,22,0,14" />

                <!-- Folder Selection -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtInstallDirLabel" Text="インストール先フォルダー:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="TxtInstallDir" Height="32" Background="#1A1C23" Foreground="#FFFFFF" BorderBrush="#2D303B" BorderThickness="1" Padding="8,5" VerticalContentAlignment="Center" FontSize="11" IsReadOnly="True" />
                        <Button Grid.Column="2" x:Name="BtnBrowse" Content="参照..." Style="{StaticResource PillButtonStyle}" Height="32" Padding="14,0" Click="BtnBrowse_Click" />
                    </Grid>
                </StackPanel>

                <!-- Options -->
                <StackPanel Grid.Row="2" Margin="0,4,0,0">
                    <CheckBox x:Name="ChkDesktop" Content="デスクトップにショートカットを作成" IsChecked="True" />
                    <CheckBox x:Name="ChkStartMenu" Content="スタートメニューにショートカットを作成" IsChecked="True" />
                    <CheckBox x:Name="ChkProtocol" Content="Robloxの起動をPrismStrapに関連付ける (ブラウザ連携)" IsChecked="True" />
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Button x:Name="BtnCancel" Content="キャンセル" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="BtnCancel_Click" />
                    <Button x:Name="BtnInstall" Content="インストール" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="24,8" Click="BtnInstall_Click" />
                </Grid>
            </Grid>

            <!-- STEP 2: Progress Panel -->
            <Grid Grid.Row="1" x:Name="PanelProgress" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="20,0">
                    <Image Source="icon.ico" Width="42" Height="42" Margin="0,0,0,16" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtProgressHeader" Text="PrismStrap をインストール中..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtProgressStatus" Text="ファイルを展開しています..." FontSize="11" Foreground="#9CA3AF" Margin="0,6,0,16" HorizontalAlignment="Center" />

                    <ProgressBar x:Name="BarProgress" Height="5" Background="#21242D" Foreground="#2563EB" BorderThickness="0" IsIndeterminate="True" />
                </StackPanel>
            </Grid>

            <!-- STEP 3: Finish Panel -->
            <Grid Grid.Row="1" x:Name="PanelFinish" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#142B20" BorderBrush="#1F4E37" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="✓" FontSize="22" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>

                    <TextBlock x:Name="TxtFinishHeader" Text="インストールが完了しました！" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtFinishDesc" Text="PrismStrap のセットアップが正常に完了しました。" FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,20" HorizontalAlignment="Center" />

                    <CheckBox x:Name="ChkLaunchNow" Content="PrismStrap を今すぐ起動する" IsChecked="True" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Button x:Name="BtnFinish" Content="完了" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="28,8" Click="BtnFinish_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
