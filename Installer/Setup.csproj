<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>PrismStrap.Installer</RootNamespace>
    <Version>0.3.0</Version>
    <Company>PrismStrap Team</Company>
    <Product>PrismStrap Setup</Product>
    <Description>PrismStrap Installer</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\icon.ico" Link="icon.ico" />
    <EmbeddedResource Include="..\publish-single\PrismStrap.exe" LogicalName="PrismStrap.exe" />
  </ItemGroup>

</Project>
